HTTP_HEADER(HttpHeaderTarget_Rest,      "sec-ch-ua-mobile",   "?0")
HTTP_HEADER(HttpHeaderTarget_Rest,      "sec-ch-ua-platform", "\"Windows\"")
HTTP_HEADER(HttpHeaderTarget_Rest,      "sec-fetch-dest",     "empty")
HTTP_HEADER(HttpHeaderTarget_Rest,      "sec-fetch-mode",     "cors")
HTTP_HEADER(HttpHeaderTarget_Rest,      "sec-fetch-site",     "same-origin")
HTTP_HEADER(HttpHeaderTarget_WebSocket, "Pragma",             "no-cache")
HTTP_HEADER(HttpHeaderTarget_WebSocket, "Cache-Control",      "no-cache")
HTTP_HEADER(HttpHeaderTarget_WebSocket, "Accept-Encoding",    "gzip, deflate, br, zstd")

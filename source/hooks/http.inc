HTTP_HEADER(HttpHeaderTarget_All,       "User-Agent",         CLIENT_USER_AGENT)
HTTP_HEADER(HttpHeaderTarget_Rest,      "X-Discord-Locale",   CLIENT_LOCALE)
HTTP_HEADER(HttpHeaderTarget_Rest,      "X-Debug-Options",    "bugReporterEnabled")
HTTP_HEADER(HttpHeaderTarget_All,       "Accept-Language",    CLIENT_ACCEPT_LANGUAGE)
HTTP_HEADER(HttpHeaderTarget_All,       "Origin",             CLIENT_ORIGIN)
HTTP_HEADER(HttpHeaderTarget_Rest,      "Referer",            CLIENT_ORIGIN "/channels/@me")
